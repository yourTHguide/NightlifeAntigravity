            "id": "fb-webhook",
            "name": "Facebook Incoming",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 2,
            "position": [
                240,
                720
            ],
            "webhookId": "fb-incoming"
        },
        {
            "parameters": {
                "jsCode": "// Normalize WhatsApp payload for omnichannel endpoint\nconst incoming = $input.first().json;\n\n// WhatsApp Business API / Twilio / WABA payloads vary\n// Adapt these field names to match YOUR WhatsApp provider\nconst normalized = {\n  channel: 'whatsapp',\n  message: incoming.Body || incoming.body || incoming.text || incoming.message?.text || incoming.entry?.[0]?.changes?.[0]?.value?.messages?.[0]?.text?.body || '',\n  from: incoming.From || incoming.from || incoming.wa_id || incoming.entry?.[0]?.changes?.[0]?.value?.messages?.[0]?.from || '',\n  sender_name: incoming.ProfileName || incoming.profile_name || incoming.entry?.[0]?.changes?.[0]?.value?.contacts?.[0]?.profile?.name || '',\n  timestamp: incoming.timestamp || new Date().toISOString()\n};\n\nreturn [{ json: normalized }];"
            },
            "id": "wa-normalize",
            "name": "Normalize WA Payload",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                500,
                200
            ]
        },
        {
            "parameters": {
                "jsCode": "// Normalize Instagram DM payload for omnichannel endpoint\nconst incoming = $input.first().json;\n\nconst normalized = {\n  channel: 'instagram',\n  message: incoming.message?.text || incoming.text || incoming.body || incoming.entry?.[0]?.messaging?.[0]?.message?.text || '',\n  ig_handle: incoming.sender?.username || incoming.ig_handle || incoming.ig_username || incoming.from || '',\n  sender_id: incoming.sender?.id || incoming.sender_id || incoming.entry?.[0]?.messaging?.[0]?.sender?.id || '',\n  sender_name: incoming.sender?.name || incoming.sender_name || incoming.from || '',\n  timestamp: incoming.timestamp || new Date().toISOString()\n};\n\nreturn [{ json: normalized }];"
            },
            "id": "ig-normalize",
            "name": "Normalize IG Payload",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                500,
                460
            ]
        },
        {
            "parameters": {
                "jsCode": "// Normalize Facebook Messenger payload for omnichannel endpoint\nconst incoming = $input.first().json;\n\nconst normalized = {\n  channel: 'facebook',\n  message: incoming.message?.text || incoming.text || incoming.body || incoming.entry?.[0]?.messaging?.[0]?.message?.text || '',\n  psid: incoming.sender?.id || incoming.psid || incoming.sender_id || incoming.entry?.[0]?.messaging?.[0]?.sender?.id || '',\n  sender_name: incoming.sender?.name || incoming.sender_name || '',\n  page_id: incoming.recipient?.id || incoming.page_id || incoming.entry?.[0]?.id || '',\n  timestamp: incoming.timestamp || new Date().toISOString()\n};\n\nreturn [{ json: normalized }];"
            },
            "id": "fb-normalize",
            "name": "Normalize FB Payload",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                500,
                720
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://www.bkkclubcrawl.com/api/omnichannel-chat",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        },
                        {
                            "name": "x-webhook-secret",
                            "value": "={{ $env.OMNICHANNEL_WEBHOOK_SECRET || '' }}"
                        }
                    ]
                },
                "sendBody": true,
                "bodyParameters": {
                    "parameters": []
                },
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify($input.first().json) }}",
                "options": {
                    "timeout": 15000,
                    "response": {
                        "response": {
                            "fullResponse": false
                        }
                    }
                }
            },
            "id": "call-ai",
            "name": "Call BCC AI Agent",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                780,
                460
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": true,
                        "leftValue": "",
                        "typeValidation": "strict"
                    },
                    "conditions": [
                        {
                            "id": "wa-condition",
                            "leftValue": "={{ $input.first().json.channel }}",
                            "rightValue": "whatsapp",
                            "operator": {
                                "type": "string",
                                "operation": "equals"
                            }
                        }
                    ],
                    "combinator": "and"
                },
                "options": {}
            },
            "id": "route-response",
            "name": "Route by Channel",
            "type": "n8n-nodes-base.switch",
            "typeVersion": 3,
            "position": [
                1060,
                460
            ],
            "parameters_extra": {
                "_note": "Configure 3 outputs: WhatsApp (channel=whatsapp), Instagram (channel=instagram), Facebook (channel=facebook). The switch node routes the AI response back to the correct channel's reply node."
            }
        },
        {
            "parameters": {
                "jsCode": "// Format reply for WhatsApp\nconst aiResponse = $input.first().json;\n\nreturn [{\n  json: {\n    to: aiResponse.user_key,\n    body: aiResponse.reply,\n    channel: 'whatsapp',\n    _meta: {\n      guest_id: aiResponse.guest_id,\n      session_stage: aiResponse.session_stage,\n      escalated: aiResponse.escalated\n    }\n  }\n}];"
            },
            "id": "wa-reply-prep",
            "name": "Prepare WA Reply",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1340,
                200
            ]
        },
        {
            "parameters": {
                "jsCode": "// Format reply for Instagram DM\nconst aiResponse = $input.first().json;\n\nreturn [{\n  json: {\n    recipient_id: aiResponse.user_key,\n    message: aiResponse.reply,\n    channel: 'instagram',\n    _meta: {\n      guest_id: aiResponse.guest_id,\n      session_stage: aiResponse.session_stage,\n      escalated: aiResponse.escalated\n    }\n  }\n}];"
            },
            "id": "ig-reply-prep",
            "name": "Prepare IG Reply",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1340,
                460
            ]
        },
        {
            "parameters": {
                "jsCode": "// Format reply for Facebook Messenger\nconst aiResponse = $input.first().json;\n\nreturn [{\n  json: {\n    recipient_id: aiResponse.user_key,\n    message: aiResponse.reply,\n    channel: 'facebook',\n    _meta: {\n      guest_id: aiResponse.guest_id,\n      session_stage: aiResponse.session_stage,\n      escalated: aiResponse.escalated\n    }\n  }\n}];"
            },
            "id": "fb-reply-prep",
            "name": "Prepare FB Reply",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1340,
                720
            ]
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{ JSON.stringify({ status: 'sent', reply: $input.first().json.body || $input.first().json.message }) }}",
                "options": {}
